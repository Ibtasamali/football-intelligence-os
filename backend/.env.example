# Copy to backend/.env. Every value is optional: without Azure keys the platform runs on local adapters.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Optional: a stronger deployment for major turning points (defaults to AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_DEPLOYMENT_LARGE=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=football_os
# Leave empty to use the in-process TTL cache
REDIS_URL=redis://localhost:6379/0
# Set to enable JWT auth (Entra ID issuer/audience) — empty = demo mode
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
API_KEYS=
